LLM_PROVIDER=ollama
MODEL=qwen2.5-coder:3b
BASE_URL=
API_KEY=

TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=2048
TIMEOUT=180
MAX_STEPS=5

SYSTEM='Ты наставник по проектированию программного обеспечения.'

MAX_HISTORY=20
MAX_CHARS=5000
MAX_TOOL_OUTPUT=10000

SKIP=.git,node_modules,__pycache__,.venv,venv,dist,build,vendor
ROOT=default
